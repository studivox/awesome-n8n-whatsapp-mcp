    {
      "parameters": {
        "jsCode": "\nconst s = $('Accumulate Counts').last() ? $('Accumulate Counts').last().json : $('Init Page State').first().json;\n// The Postgres finalize node's own output replaces each item's json\n// entirely (query columns only) -- the pre-finalize \"outcome\" this\n// code needs was computed upstream by Classify Create/Mutate/Idempotency\n// Result. Zip that list back up with the finalize node's out_ok by\n// position: the Postgres node processes items 1:1, preserving order\n// and count, so index-alignment is safe here.\nlet pre = [];\nlet post = [];\ntry { pre = $('Merge Finalize Inputs').all().map(i => i.json); } catch (e) { pre = []; }\ntry { post = $('Finalize Outbox Item').all().map(i => i.json); } catch (e) { post = []; }\nconst claimed = pre.length;\nlet applied = 0, conflicted = 0, failed = 0;\nfor (let idx = 0; idx < pre.length; idx++) {\n  const outcome = pre[idx].outcome;\n  const ok = post[idx] ? post[idx].out_ok : false;\n  if (outcome === 'success' && ok) applied++;\n  else if (outcome === 'conflict') conflicted++;\n  else failed++;\n}\nreturn [{ json: {\n  syncCalendarId: s.syncCalendarId, ownerId: s.ownerId,\n  pull: { pages: s.pages, applied: s.applied, tombstoned: s.tombstoned, unknown: s.unknown, malformed: s.malformed, conflict: s.conflict },\n  outbox: { claimed, applied, conflicted, failed },\n} }];\n"
      },
