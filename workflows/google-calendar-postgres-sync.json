        "jsCode": "\nconst resp = $json;\nconst j = $('Build Mutate Request').item.json;\nconst httpStatus = (resp.statusCode !== undefined) ? resp.statusCode : 0;\nif (httpStatus === 412) {\n  return { json: {\n    outcome: 'conflict', outboxId: j.outboxId, syncCalendarId: j.syncCalendarId, ownerId: j.ownerId,\n    appointmentId: j.appointmentId, operation: j.operation,\n    googleEventId: j.googleEventId, etag: null, updated: null,\n    reason: 'etag_mismatch', details: { expected: j.currentEtag },\n  } };\n}\nif ((httpStatus >= 200 && httpStatus < 300) || httpStatus === 204) {\n  const e = resp.body || {};\n  return { json: {\n    outcome: 'success', outboxId: j.outboxId, syncCalendarId: j.syncCalendarId, ownerId: j.ownerId,\n    appointmentId: j.appointmentId, operation: j.operation,\n    googleEventId: j.googleEventId, etag: e.etag || null, updated: e.updated || null, reason: null, details: null,\n  } };\n}\nreturn { json: {\n  outcome: 'failure', outboxId: j.outboxId, syncCalendarId: j.syncCalendarId, ownerId: j.ownerId,\n  appointmentId: j.appointmentId, operation: j.operation,\n  googleEventId: null, etag: null, updated: null, reason: `http_${resp.statusCode}`, details: null,\n} };\n",
